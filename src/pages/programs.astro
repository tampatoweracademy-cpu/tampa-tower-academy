---
import Base from '../layouts/Base.astro';
const enrollUrl = 'https://forms.gle/GSf12Znbd63fsDfk7';
---

<Base title="Our Home Education Program" path="/programs" description="Tampa Tower's Bible-based K–8 Home Education Instructional Program — parent-led or instructor-guided learning with Florida B.E.S.T.-aligned ELA curriculum. Eligible PEP families may use scholarship funds toward approved program tuition.">
  <section class="band-navy">
    <div class="wrap wrap-narrow">
      <p class="eyebrow" style="color: var(--gold-light)">Our program</p>
      <h1 style="color: var(--white)">Our Home Education Program</h1>
      <p class="lead" style="color: rgba(247,245,239,0.85)">
        Tampa Tower is a Bible-based K–8 Home Education Instructional Program. We combine
        Florida B.E.S.T.-aligned ELA curriculum with guided instruction and academic support
        for PEP and homeschool families.
      </p>
    </div>
  </section>

  <!-- Two ways to learn -->
  <section>
    <div class="wrap wrap-narrow center" style="margin-bottom:2rem">
      <p class="eyebrow">Two ways to learn</p>
      <h2>Choose the path that fits your family.</h2>
      <p class="lead">
        Our program is built around Tampa Tower's Bible-based ELA curriculum aligned with Florida's
        B.E.S.T. Standards. Families may choose parent-led learning or instructor-guided learning.
      </p>
    </div>
    <div class="wrap grid grid-2">
      <article class="card">
        <span class="ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 5h6a3 3 0 0 1 3 3v11a2.5 2.5 0 0 0-2.5-2.5H3Z"/><path d="M21 5h-6a3 3 0 0 0-3 3v11a2.5 2.5 0 0 1 2.5-2.5H21Z"/></svg>
        </span>
        <h3>Parent-Led Learning</h3>
        <p>Families can use Tampa Tower's complete Bible-based ELA curriculum to guide learning at home with curriculum, structure, assessments, and support.</p>
      </article>
      <article class="card">
        <span class="ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/></svg>
        </span>
        <h3>Instructor-Guided Learning</h3>
        <p>Families may choose instruction from a qualified instructor who teaches and supports students using the Tampa Tower curriculum.</p>
      </article>
    </div>
  </section>

  <!-- Curriculum + instruction -->
  <section>
    <div class="wrap wrap-narrow stack">
      <p class="eyebrow">Curriculum + instruction</p>
      <h2>What our program includes</h2>
      <p>
        Tampa Tower's Home Education Instructional Program combines our proprietary Bible-based ELA
        curriculum with guided instruction, assessments, practice, feedback, and academic support.
      </p>
      <h3>Program Tuition</h3>
      <p>
        Tampa Tower Home Education Instructional Program tuition covers our proprietary Bible-based ELA
        curriculum together with the instructional services, assessments, practice, feedback, and
        academic support included in the selected program offering.
      </p>
      <p>
        Eligible PEP families may use available Step Up For Students scholarship funds toward approved
        program tuition. Applicable pricing is available through EMA / Find Providers.
      </p>
      <p>There are no application or registration fees.</p>
    </div>
  </section>

  <section class="band-gold">
    <div class="wrap wrap-narrow">
      <h2>PEP Scholarship Funding</h2>
      <p>
        Tampa Tower is an approved Step Up For Students provider in the Home Education Instructional
        Program category.
      </p>
      <ol class="flow">
        <li>
          <h3>Apply with Step Up For Students</h3>
          <p>Families apply for the PEP scholarship through Step Up For Students. Once approved, funds are held in an education account for your child.</p>
        </li>
        <li>
          <h3>Select Tampa Tower as your provider</h3>
          <p>Because we're an approved Home Education Instructional Program provider on the EMA Marketplace, eligible scholarship funds may be used toward approved Tampa Tower HEIP tuition.</p>
        </li>
        <li>
          <h3>Register for the program</h3>
          <p>Complete our short registration form.</p>
        </li>
      </ol>

      <div class="note">
        <strong>Program details are being finalized.</strong>
        <p>Additional information about grade levels, instructional options, and program resources
        will be published here shortly. Have a question now? <a href="/contact">Reach out</a> —
        we're happy to help.</p>
      </div>
    </div>
  </section>

  <!-- Learning pod / co-op — kept separate from HEIP tuition -->
  <section>
    <div class="wrap wrap-narrow stack">
      <p class="eyebrow">Learning together</p>
      <h2>Learning Together</h2>
      <p>
        Families participating in Tampa Tower's Home Education Instructional Program may also have
        opportunities for their children to learn, practice, collaborate, and socialize with other PEP
        and homeschool students in a small learning pod/co-op environment.
      </p>
      <p>There is no separate fee for participation in the learning pod/co-op.</p>
      <p class="note">
        Participation in the learning pod/co-op does not constitute enrollment in a private school.
        Parents remain responsible for directing their child's PEP or home education.
      </p>
    </div>
  </section>

  <section class="band-navy center">
    <div class="wrap wrap-narrow stack">
      <div class="sufs-tile">
        <img src="/images/step-up-logo.png" alt="Step Up For Students" width="520" height="520" />
      </div>
      <h2>Approved Step Up For Students provider</h2>
      <p class="lead">PEP Scholarship Eligible · Home Education Instructional Program</p>
      <p><a class="btn btn-primary" href={enrollUrl} target="_blank" rel="noopener">Get Started</a></p>
    </div>
  </section>
</Base>

<style>
  .flow { list-style: none; counter-reset: step; padding: 0; margin: 1.5rem 0 2.5rem; display: grid; gap: 1.25rem; }
  .flow li { counter-increment: step; position: relative; padding-left: 3.5rem; }
  .flow li::before {
    content: counter(step);
    position: absolute; left: 0; top: 0;
    width: 2.4rem; height: 2.4rem;
    display: grid; place-items: center;
    background: var(--navy); color: var(--white);
    border-radius: 50%; font-family: var(--font-serif); font-size: 1.2rem;
  }
  .flow h3 { margin-bottom: 0.25rem; }
  .note { background: var(--cream-dark); border-left: 4px solid var(--gold); border-radius: 8px; padding: 1.25rem 1.5rem; }
  .note p { margin: 0.5rem 0 0; color: var(--muted); }
</style>
