---
import Base from '../layouts/Base.astro';
import Scripture from '../components/Scripture.astro';
const enrollUrl = 'https://forms.gle/GSf12Znbd63fsDfk7';
---

<Base path="/">
  <!-- Hero -->
  <section class="hero band-navy">
    <div class="wrap hero-inner">
      <img src="/images/logo-dark.png" alt="Tampa Tower crest" width="205" height="209" class="hero-logo" />
      <p class="eyebrow" style="color: var(--gold-light)">Tampa Tower · Grades K–8</p>
      <h1>Bible-Based <span class="nowrap">K–8</span> Home Education</h1>
      <p class="lead tagline">Strong literacy. Strong values. Purposeful learning.</p>
      <p class="lead">
        Tampa Tower provides a Bible-based K–8 Home Education Instructional Program combining
        Florida B.E.S.T.-aligned ELA curriculum with guided instruction and academic support
        for PEP and homeschool families.
      </p>
      <p class="tuition-flag">Approved Step Up For Students Provider · PEP Scholarship Eligible</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/programs">Explore Our Program</a>
        <a class="btn btn-ghost" href={enrollUrl} target="_blank" rel="noopener">Get Started</a>
      </div>
    </div>
  </section>

  <!-- Value props -->
  <section>
    <div class="wrap">
      <div class="center" style="max-width: 44rem; margin-inline: auto;">
        <p class="eyebrow">Why families choose us</p>
        <h2>Learning built around your child</h2>
      </div>
      <div class="grid grid-3 mt-2">
        <article class="card">
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19V6a2 2 0 0 1 2-2h8l6 6v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M14 4v6h6"/></svg>
          </span>
          <h3>Grouped by skill, not by age</h3>
          <p>Kids develop on different timelines. Our program is designed for flexible, multi-age learning, so every child receives instruction and practice at the right skill level.</p>
        </article>
        <article class="card">
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="M21 8v6"/><path d="M7 10v5c0 1 2 3 5 3s5-2 5-3v-5"/></svg>
          </span>
          <h3>Engaged, not just managed</h3>
          <p>Students are far less likely to disengage when the work meets them where they are. We match instruction and assignments to each learner.</p>
        </article>
        <article class="card">
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-4.35-9.5-8.5A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6.5C19 16.65 12 21 12 21Z"/></svg>
          </span>
          <h3>Character and truth</h3>
          <p>We teach language, character, and wisdom alongside academics — forming kind leaders, not just strong test-takers.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- PEP scholarship funding explainer -->
  <section class="band-gold">
    <div class="wrap wrap-narrow center stack">
      <p class="eyebrow">PEP scholarship funding</p>
      <h2>PEP Scholarship Eligible</h2>
      <p class="lead">
        Eligible PEP families may use available Step Up For Students scholarship funds toward approved
        Tampa Tower Home Education Instructional Program tuition. No application or registration fees.
      </p>
      <p>
        <a class="btn btn-outline" href="/programs">How the scholarship works</a>
      </p>
    </div>
  </section>

  <!-- Curriculum + instruction -->
  <section>
    <div class="wrap wrap-narrow center stack">
      <p class="eyebrow">Curriculum + instruction</p>
      <h2>What our program includes</h2>
      <p class="lead">
        Tampa Tower's Home Education Instructional Program combines our proprietary Bible-based ELA
        curriculum with guided instruction, assessments, practice, feedback, and academic support.
      </p>
      <p>
        <a class="btn btn-outline" href="/curriculum">Explore our curriculum</a>
      </p>
    </div>
  </section>

  <!-- Faith / mission — rotating scripture drawn from the program's materials -->
  <Scripture />

  <!-- Approved provider band -->
  <section>
    <div class="wrap provider">
      <div>
        <p class="eyebrow">Officially recognized</p>
        <h2>An approved Step Up For Students provider</h2>
        <p class="lead">
          Tampa Tower is an approved Step Up For Students provider in the Home Education
          Instructional Program category. Eligible scholarship funds may be used toward approved
          Tampa Tower HEIP tuition.
        </p>
        <a class="btn btn-outline" href="/contact">Meet with us</a>
      </div>
      <div class="sufs-tile">
        <img src="/images/step-up-logo.png" alt="Step Up For Students" width="520" height="520" />
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="band-navy center">
    <div class="wrap wrap-narrow stack">
      <h2>Ready to give your child the right start?</h2>
      <p class="lead">Registration takes just a few minutes. Select Tampa Tower as your provider — we'd love to meet your family.</p>
      <p><a class="btn btn-primary" href={enrollUrl} target="_blank" rel="noopener">Get Started</a></p>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .hero-inner { text-align: center; max-width: 46rem; margin-inline: auto; }
  .hero-logo { width: 205px; height: auto; margin: 0 auto 1.5rem; filter: drop-shadow(0 8px 22px rgba(0, 0, 0, 0.35)); }
  .hero h1 { color: var(--white); }
  .nowrap { white-space: nowrap; }
  .tagline { font-weight: 700; color: var(--gold-light); }
  .tuition-flag {
    display: inline-block;
    margin: 0.5rem 0 1.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--gold);
    border-radius: 999px;
    color: var(--gold-light);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .cta-row { display: flex; gap: 0.85rem; justify-content: center; flex-wrap: wrap; }

  .provider { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 46rem) { .provider { grid-template-columns: 1.5fr 1fr; } }
</style>
